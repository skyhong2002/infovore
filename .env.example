# ── Copy this file to .env and fill in your own accounts ──────────────────
# Every value below is optional and ships with the author's account as a
# demo default — REPLACE them with your own (or you'll render someone else's
# stats). Leave a source out of SOURCES if you don't use it.

# Who the page is about, and when to re-fetch (HH:MM in GMT+8, comma-separated).
OWNER_NAME=Sky Hong
REFRESH_INTERVAL_MINUTES=60
PORT=3000
INGEST_PORT=3001
DATABASE_PATH=./data/infovore.sqlite
PUBLIC_BASE_URL=http://localhost:3000
# Required only for POST /api/ingest/events. Generate a long random secret.
INGEST_TOKEN=
# Dedicated Android Health Connect token. Falls back to INGEST_TOKEN when blank.
HEALTH_CONNECT_TOKEN=
# Health becomes unhealthy when every source is older than this threshold.
MAX_SOURCE_AGE_HOURS=36

# Which sources to enable (comma-separated). Empty = all.
# Options: backloggd,kitsu,statsfm,simkl,goodreads,youtube
# e.g. SOURCES=kitsu,statsfm
SOURCES=

# ── Backloggd (games) — public profile, no key ────────────────────────────
BACKLOGGD_USERNAME=skychopath

# ── Kitsu (anime + manga) — public JSON:API ───────────────────────────────
# Find your numeric user id: https://kitsu.app/api/edge/users?filter[slug]=YOUR_SLUG
KITSU_SLUG=skyhong2002
KITSU_USER_ID=1366093

# ── stats.fm (music) — public API; set your profile to public ─────────────
STATSFM_USERNAME=skyhong2002

# ── Simkl (movies + TV) — needs a client id + an OAuth token ──────────────
# 1. Create an app: https://simkl.com/settings/developer/  → copy the Client ID.
# 2. Get a token (device/PIN flow):
#      curl "https://api.simkl.com/oauth/pin?client_id=YOUR_CLIENT_ID"
#      → open https://simkl.com/pin, enter the user_code, then poll:
#      curl "https://api.simkl.com/oauth/pin/USER_CODE?client_id=YOUR_CLIENT_ID"
#      → the access_token in the response goes below.
# Your numeric user id is in your profile URL: simkl.com/<id>/dashboard/
SIMKL_USER_ID=8074923
SIMKL_CLIENT_ID=
SIMKL_ACCESS_TOKEN=

# ── Goodreads (books) — public shelves; RSS must be enabled on your account ─
# The id is the number+slug in your profile URL: /user/show/<this-part>
GOODREADS_USER_ID=160195773-skychopath

# ── YouTube — mirrored from urtube (https://urtube.observe.tw) ────────────
# The urtube handle whose public dashboard infovore mirrors (stats, top
# channels, topics, per-day time). The dashboard must be public.
URTUBE_BASE_URL=https://urtube.observe.tw
URTUBE_HANDLE=skyhong.tw

# ── YouTube legacy ingest — superseded by urtube; leave blank ─────────────
# Required before importing a Takeout ZIP. Generate one stable secret with at
# least 32 characters and keep it unchanged; it encrypts search queries and
# the Google Data Portability refresh token at rest.
YOUTUBE_PRIVATE_DATA_KEY=
# Dedicated least-privilege token for the Chrome viewing capture extension.
# Generate a different secret from INGEST_TOKEN.
YOUTUBE_CAPTURE_TOKEN=
# Used to enrich public video ids with duration, tags, description and artwork.
YOUTUBE_API_KEY=
# Optional official daily sync. myactivity.youtube is a Restricted OAuth scope.
GOOGLE_DATA_PORTABILITY_CLIENT_ID=
GOOGLE_DATA_PORTABILITY_CLIENT_SECRET=
GOOGLE_DATA_PORTABILITY_REDIRECT_URI=http://localhost:3001/api/ingest/youtube/oauth/callback
YOUTUBE_SYNC_HOUR=4

# Optional AI topic classification. Disabled unless explicitly enabled.
# Only public video metadata is sent.
AI_CLASSIFICATION_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# ── Reverse proxy only (docker-compose.traefik.yml) ───────────────────────
# DOMAIN=status.example.com
# Optional: an old domain that now CNAMEs to DOMAIN, kept serving during a
# migration. Defaults to DOMAIN (no-op) if unset.
# LEGACY_DOMAIN=old.example.com
