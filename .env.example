# ── Copy this file to .env and fill in your own accounts ──────────────────
# Every value below is optional and ships with the author's account as a
# demo default — REPLACE them with your own (or you'll render someone else's
# stats). Leave a source out of SOURCES if you don't use it.

# Who the page is about, and when to re-fetch (HH:MM in GMT+8, comma-separated).
OWNER_NAME=Sky Hong
REFRESH_TIMES=06:00,18:00
PORT=3000

# Which sources to enable (comma-separated). Empty = all.
# Options: backloggd,kitsu,statsfm,simkl,goodreads
# e.g. SOURCES=kitsu,statsfm
SOURCES=

# ── Backloggd (games) — public profile, no key ────────────────────────────
BACKLOGGD_USERNAME=skychopath

# ── Kitsu (anime + manga) — public JSON:API ───────────────────────────────
# Find your numeric user id: https://kitsu.app/api/edge/users?filter[slug]=YOUR_SLUG
KITSU_SLUG=skyhong2002
KITSU_USER_ID=1366093

# ── stats.fm (music) — public API; set your profile to public ─────────────
STATSFM_USERNAME=skyhong2002

# ── Simkl (movies + TV) — needs a client id + an OAuth token ──────────────
# 1. Create an app: https://simkl.com/settings/developer/  → copy the Client ID.
# 2. Get a token (device/PIN flow):
#      curl "https://api.simkl.com/oauth/pin?client_id=YOUR_CLIENT_ID"
#      → open https://simkl.com/pin, enter the user_code, then poll:
#      curl "https://api.simkl.com/oauth/pin/USER_CODE?client_id=YOUR_CLIENT_ID"
#      → the access_token in the response goes below.
# Your numeric user id is in your profile URL: simkl.com/<id>/dashboard/
SIMKL_USER_ID=8074923
SIMKL_CLIENT_ID=
SIMKL_ACCESS_TOKEN=

# ── Goodreads (books) — public shelves; RSS must be enabled on your account ─
# The id is the number+slug in your profile URL: /user/show/<this-part>
GOODREADS_USER_ID=160195773-skychopath

# ── Reverse proxy only (docker-compose.traefik.yml) ───────────────────────
# DOMAIN=status.example.com
# Optional: an old domain that now CNAMEs to DOMAIN, kept serving during a
# migration. Defaults to DOMAIN (no-op) if unset.
# LEGACY_DOMAIN=old.example.com
