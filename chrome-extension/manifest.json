{
  "manifest_version": 3,
  "name": "infovore YouTube Capture",
  "version": "1.11.3",
  "description": "Privately syncs cross-device YouTube history, saved progress, and measured Chrome viewing to infovore.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://infovore.skyhong.tw/*",
    "https://myactivity.google.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "infovore YouTube Capture",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://infovore.skyhong.tw/platforms/youtube*"
      ],
      "js": [
        "dashboard.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://myactivity.google.com/product/youtube*"
      ],
      "js": [
        "myactivity.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "history.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
