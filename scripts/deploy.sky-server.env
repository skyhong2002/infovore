# scripts/deploy.sh target for production on sky-server: Dokploy compose
# project compose-calculate-online-port-oqidr1. Its service.env is root-only, so
# run the rollout with sudo from the ~/Projects/infovore checkout:
#   git pull --ff-only && sudo -n scripts/deploy.sh scripts/deploy.sky-server.env
# Dokploy's stored compose uses the same fixed image tag, so a redeploy from the
# Dokploy UI starts whatever this script built last.
INFOVORE_PRODUCTION=compose-calculate-online-port-oqidr1-infovore-1
INFOVORE_COMPOSE_PROJECT=compose-calculate-online-port-oqidr1
INFOVORE_COMPOSE_FILES="-f /etc/dokploy/compose/compose-calculate-online-port-oqidr1/code/docker-compose.yml"
INFOVORE_CANDIDATE_OVERLAY=docker-compose.candidate-dokploy.yml
INFOVORE_IMAGE=blog-svc-infovore:production
